# ---- Signing secret (session cookies and travel-agent offers) ----
# Optional when DATABASE_URL is set: a random secret is then generated once and stored in the
# database. If you set it, use a long random value (an empty value is ignored).
SESSION_SECRET=

# ---- Encryption of saved travellers (passports, photos) ----
# Recommended in production: a long random value, set once and never changed (changing it — or,
# when unset, changing SESSION_SECRET — makes previously saved travellers unreadable).
DATA_ENCRYPTION_KEY=

# ---- Back office ----
# Comma-separated emails of the operations team (access to /admin).
ADMIN_EMAILS=

# ---- Email (traveller notifications) ----
# Resend (https://resend.com): API key and a verified sender, e.g. "Saudi Trip <noreply@your-domain>".
# Without them, messages are recorded in the back office but not sent.
RESEND_API_KEY=
EMAIL_FROM=

# ---- Digital wallet ----
# Vercel Blob (Storage → Blob, connected to the project) sets BLOB_READ_WRITE_TOKEN automatically.
# Files are encrypted before upload; without it they are kept in the database (development only).
BLOB_READ_WRITE_TOKEN=
# Central platform for the official eVisa / insurance PDFs (sandbox specimens when empty).
CENTRAL_PLATFORM_URL=
CENTRAL_PLATFORM_TOKEN=

# ---- Guide & map ----
# Map tiles (online). Default: OpenStreetMap's public tiles, which are for light use only —
# set a production tile provider (e.g. MapTiler, Stadia, Mapbox) URL with its key and attribution.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
# Official destinations source (admin "Sync official source"); disabled when empty.
OFFICIAL_GUIDE_URL=
OFFICIAL_GUIDE_TOKEN=
# Overpass endpoint for the OpenStreetMap import (default: overpass-api.de).
OVERPASS_URL=

# ---- Database ----
# PostgreSQL connection string (Vercel Storage → Neon sets DATABASE_URL / POSTGRES_URL automatically).
# Leave empty for local development: data is stored in data/db.json (or DB_FILE).
DATABASE_URL=

# ---- MT eVisa (Ministry of Tourism) OTA integration ----
# Environment: dev | stage | production. Leave MT_CLIENT_ID empty to run in MOCK mode.
MT_ENV=dev
MT_DMC_ID=
MT_CLIENT_ID=
MT_CLIENT_SECRET=
MT_OTA_LICENSE_NO=

# ---- Pricing ----
# Visa + insurance fee per traveller (SAR)
VISA_INSURANCE_FEE_SAR=402.21

# ---- Passport OCR (optional; defaults to the self-hosted assets under /tesseract) ----
NEXT_PUBLIC_TESSERACT_WORKER_PATH=
NEXT_PUBLIC_TESSERACT_CORE_PATH=
NEXT_PUBLIC_TESSERACT_LANG_PATH=

# ---- AI assistant & live translation (Claude) ----
# Without a key the assistant and translation run in sandbox mode.
ANTHROPIC_API_KEY=
# Optional: model (default claude-opus-5) and daily message limits per account / per visitor.
ASSISTANT_MODEL=
ASSISTANT_DAILY_LIMIT_USER=100
ASSISTANT_DAILY_LIMIT_GUEST=25
