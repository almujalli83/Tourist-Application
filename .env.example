# ---- Signing secret (session cookies and travel-agent offers) ----
# Optional when DATABASE_URL is set: a random secret is then generated once and stored in the
# database. If you set it, use a long random value (an empty value is ignored).
SESSION_SECRET=

# ---- Database ----
# PostgreSQL connection string (Vercel Storage → Neon sets DATABASE_URL / POSTGRES_URL automatically).
# Leave empty for local development: data is stored in data/db.json (or DB_FILE).
DATABASE_URL=

# ---- MT eVisa (Ministry of Tourism) OTA integration ----
# Environment: dev | stage | production. Leave MT_CLIENT_ID empty to run in MOCK mode.
MT_ENV=dev
MT_DMC_ID=
MT_CLIENT_ID=
MT_CLIENT_SECRET=
MT_OTA_LICENSE_NO=

# ---- Pricing ----
# Visa + insurance fee per traveller (SAR)
VISA_INSURANCE_FEE_SAR=402.21

# ---- Passport OCR (optional; defaults to the self-hosted assets under /tesseract) ----
NEXT_PUBLIC_TESSERACT_WORKER_PATH=
NEXT_PUBLIC_TESSERACT_CORE_PATH=
NEXT_PUBLIC_TESSERACT_LANG_PATH=
